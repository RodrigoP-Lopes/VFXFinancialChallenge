{
  "info": {
    "_postman_id": "8f1c2b64-3d1e-4c7a-9d0f-6a2b5c8e14d3",
    "name": "Foreign Exchange Rate API",
    "description": "CRUD requests for the Foreign Exchange Rate API. Change the baseUrl variable to match your launch profile (http://localhost:5156 for the http profile, https://localhost:7029 for https, https://localhost:44317 for IIS Express).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5156",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List rates",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rates",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rates"]
        }
      },
      "response": []
    },
    {
      "name": "Get rate",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rates/USD/EUR",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rates", "USD", "EUR"]
        }
      },
      "response": []
    },
    {
      "name": "Create rate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"baseCurrency\": \"USD\",\n  \"quoteCurrency\": \"EUR\",\n  \"bid\": 0.91,\n  \"ask\": 0.92\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/rates",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rates"]
        }
      },
      "response": []
    },
    {
      "name": "Update rate",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bid\": 0.93,\n  \"ask\": 0.94\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/rates/USD/EUR",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rates", "USD", "EUR"]
        }
      },
      "response": []
    },
    {
      "name": "Delete rate",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rates/USD/EUR",
          "host": ["{{baseUrl}}"],
          "path": ["api", "rates", "USD", "EUR"]
        }
      },
      "response": []
