    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0127fa27-7e67-4eb4-8894-6331aa712f53</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32">
